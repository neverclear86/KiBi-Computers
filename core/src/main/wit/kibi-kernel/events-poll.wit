package kibi:kernel@0.1.0;

/// p2 でイベントキューを待つ（ADR 0426）。仮置き: interface・関数・型・`wasi:*` の版は、p2 の層（#685）を作るときに直してよい（v0.1.0 までは版を変えずに直す）。
interface events-poll {
    use events.{event-queue};
    use wasi:io/poll@0.2.3.{pollable};

    /// イベントが届く（か、あふれて捨てた分がある）と ready になる pollable（p1 の FD_READ と同じ条件）
    subscribe: func(q: borrow<event-queue>) -> pollable;
}
