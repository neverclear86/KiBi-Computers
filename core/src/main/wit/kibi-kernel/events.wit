package kibi:kernel@0.1.0;

/// カーネルのイベント（#63。ADR 0063）を受け取るキュー（#73。ADR 0073）。
///
/// p1 では、`event-queue` のハンドルはカーネルの fd 番号。`poll_oneoff` の `FD_READ` で、イベントが届く（か、あふれて捨てた分がある）まで待てる。
/// p2 の `pollable`・p3 の async での待ち方は、`wasi:io` に依存しないよう別の interface（`events-poll`・`events-async`。仮置き。ADR 0426）に置く。
/// タイマー（`timers`）を作るときにキューを渡すと、鳴るたびに種類 "timer" のイベントが届く（ADR 0426）。
/// 保存から戻るたびに、カーネルが種類 "restored"・source ""・値 [integer(実時間の飛び ns), integer(ゲーム内時間の飛び tick)]
/// のイベントを1件出す（成功した復元だけ。飛びが 0・負でも出す。#87、ADR 0087）。意味は「保存から戻った」だけで、画面が空とは約束しない。
/// デバイスも同じ種類名を出せるので、カーネルのものは source "" で見分ける。
/// デバイスをつなぐ・外すたびに、カーネルが種類 "device-attached"・"device-detached"、source ""、値 [text(address), text(種類)]
/// のイベントを1件出す（成功した接続・切断だけ。#67、ADR 0067）。同じ address の接続と切断は起きた順に並び、届いた時点で
/// `kibi:device` の一覧は新しい表になっている。起動前・再起動の前の接続は届かない（起動したら一覧を読む）。
/// 保存から戻ったときは、"restored" の後に、戻した先でつなぎ直した全デバイスの "device-attached" が届く（保存の前に
/// つないでいた分と重なりうる。消えた分の "device-detached" は出ない）。受け手は "restored" を受けたとき・dropped が 0 でないときに一覧を読み直す。
/// デバイスも同じ種類名を出せるので、カーネルのものは source "" で見分ける。
interface events {
    use types.{error-code};

    /// イベントの値（カーネルの `EventValue`）
    variant event-value {
        integer(s64),
        float(f64),
        boolean(bool),
        text(string),
        bytes(list<u8>),
    }

    /// イベント1つ
    record event {
        /// 種類（`KernelEvent.type`。1..64 バイト）
        kind: string,
        /// 出したもの（デバイスの識別子など。なければ ""）
        source: string,
        /// 値（32 個まで）
        values: list<event-value>,
    }

    /// `take` の結果
    record event-batch {
        /// 取り出したイベント（古い順）
        events: list<event>,
        /// 前回の取り出しから、あふれて捨てた数
        dropped: u64,
    }

    /// イベントキュー。受け取る種類を決めて開き、待たずに取り出す。
    resource event-queue {
        /// キューを開く。kinds が空ならすべての種類を受け取る。
        /// kinds は 16 個まで、それぞれ 1..64 バイトの UTF-8（外れれば invalid）。
        /// capacity を省くと既定（仮の値 64。確定は #251）。1..256 の外は invalid。
        /// マシンのキューの数が上限なら nfile、プロセスのハンドル表が満杯なら mfile。
        open: static func(kinds: list<string>, capacity: option<u32>) -> result<event-queue, error-code>;

        /// 待たずに最大 max 個取り出す（なければ空）。max は 1 以上（0 は invalid）。キューの容量より大きければ「全部」。
        take: func(max: u32) -> result<event-batch, error-code>;
    }
}
