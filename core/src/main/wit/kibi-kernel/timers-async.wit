package kibi:kernel@0.1.0;

/// p3 でタイマーを待つ（ADR 0426）。仮置き: interface・関数・型は、p3 の層 #266 を作るときに直してよい（v0.1.0 までは版を変えずに直す）。`wasi:*` に依存しない。
interface timers-async {
    use types.{error-code};
    use timers.{timer};

    /// 回数が 1 以上になるまで待ち、取り出して 0 に戻す（read を待つ形にしたもの）。
    /// キューを渡して作ったタイマーは、待たずに invalid（ずっと鳴らないため）
    wait: async func(t: borrow<timer>) -> result<u64, error-code>;
}
