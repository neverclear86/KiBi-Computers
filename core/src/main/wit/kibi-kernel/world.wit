package kibi:kernel@0.1.0;

/// p1 のゲスト向け（wasi:* を参照しない）。`kibi:kernel` の p1 の interface をまとめて import する
/// （ゲストがコンポーネントにするとき・`component embed` に使う）
world imports {
    import types;
    import events;
    import timers;
}

/// p2 のゲスト向け（仮置き。ADR 0426）
world imports-p2 {
    include imports;
    import timers-poll;
    import events-poll;
}

/// p3 のゲスト向け（仮置き。ADR 0426）
world imports-p3 {
    include imports;
    import timers-async;
    import events-async;
}
