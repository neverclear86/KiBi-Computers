package kibi:kernel@0.1.0;

/// p3 でイベントキューを待つ（ADR 0426）。仮置き: interface・関数・型は、p3 の層 #266 を作るときに直してよい（v0.1.0 までは版を変えずに直す）。`wasi:*` に依存しない。
interface events-async {
    use types.{error-code};
    use events.{event-queue, event-batch};

    /// 1 つ以上届く（か、あふれて捨てた分がある）まで待ち、最大 max 個取り出す。max の扱いとエラーは event-queue.take と同じ
    take: async func(q: borrow<event-queue>, max: u32) -> result<event-batch, error-code>;
}
