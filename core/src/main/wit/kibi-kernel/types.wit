package kibi:kernel@0.1.0;

/// 独自拡張（`kibi:*`）で共通に使う型（#73。ADR 0073）。
interface types {
    /// エラー。WASI p1 の errno（`wasi_snapshot_preview1`）から success を除いた名前を、同じ順に並べる。
    /// p1 向けの import では、p1 の errno = 判別子 + 1 で写る（例: `invalid` は判別子 27、p1 の `inval` は 28）。
    /// マシン全体の上限に当たったら `nfile`、プロセスのハンドル表が満杯なら `mfile`。
    enum error-code {
        too-big,
        access,
        addr-in-use,
        addr-not-avail,
        af-not-supported,
        again,
        already,
        bad-descriptor,
        bad-message,
        busy,
        canceled,
        child,
        conn-aborted,
        conn-refused,
        conn-reset,
        deadlock,
        dest-addr-required,
        domain,
        quota,
        exist,
        fault,
        file-too-large,
        host-unreachable,
        identifier-removed,
        illegal-byte-sequence,
        in-progress,
        interrupted,
        invalid,
        io,
        is-connected,
        is-directory,
        loop,
        mfile,
        too-many-links,
        message-size,
        multihop,
        name-too-long,
        net-down,
        net-reset,
        net-unreachable,
        nfile,
        no-buffers,
        no-device,
        no-entry,
        no-exec,
        no-lock,
        no-link,
        no-memory,
        no-message,
        no-protocol-option,
        no-space,
        no-sys,
        not-connected,
        not-directory,
        not-empty,
        not-recoverable,
        not-socket,
        not-supported,
        no-tty,
        no-such-device,
        overflow,
        owner-dead,
        not-permitted,
        pipe,
        protocol,
        protocol-not-supported,
        protocol-type,
        range,
        read-only,
        invalid-seek,
        no-such-process,
        stale,
        timed-out,
        text-file-busy,
        cross-device,
        not-capable,
    }
}
