package kibi:computer@0.1.0;

/// `kibi:computer` の interface をまとめて import する world（ゲストがコンポーネントにするとき・`component embed` に使う）
world imports {
    import memory;
    import clock;
    import power;
    import access;
}

/// p2 のゲスト向け（#685。ADR 0685）。memory の commit の ptr は、lower した commit を import した core インスタンスの線形メモリの番地（p1 と同じ。#777。ADR 0777）。
/// p3 の world はまだ置かない（#266 で足す。それまでは p3 のゲストもこの形を使う想定）
world imports-p2 {
    import memory;
    import clock;
    import power;
    import access;
}
