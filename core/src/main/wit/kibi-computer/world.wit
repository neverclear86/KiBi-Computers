package kibi:computer@0.1.0;

/// `kibi:computer` の interface をまとめて import する world（ゲストがコンポーネントにするとき・`component embed` に使う）
world imports {
    import memory;
    import clock;
    import power;
}

/// p2 のゲスト向け（#685。ADR 0685）。memory は p2 では出さない（commit が線形メモリの番地を受けるため。p2/p3 での形は別の Issue で決める）
world imports-p2 {
    import clock;
    import power;
}
