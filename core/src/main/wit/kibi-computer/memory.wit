package kibi:computer@0.1.0;

/// 残りの RAM を扱う（#408。#370 で決定。#73 で #408 の `kibi:memory` から `kibi:computer/memory` に移した）。
/// RAM は、初めて書き込んだ 4 KiB の区画の数で数える（#407）。
///
/// p1 向けには、ADR 0073 の規則でモジュール `kibi:computer/memory@0.1.0` の import（`remaining`・`commit`）として出している。
interface memory {
    /// 残りの RAM（バイト）。プロセスの上限とマシンの RAM のうち、小さい方の残り。
    remaining: func() -> u64;

    /// [ptr, ptr+len) の区画を今のうちに数える。
    /// 数えた後の残りが keep 未満になるなら、何も数えずに false。
    /// 新しく数える区画がなければ true。範囲が線形メモリの外なら false。
    commit: func(ptr: u32, len: u32, keep: u64) -> bool;
}
