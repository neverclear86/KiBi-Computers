package kibi:computer@0.1.0;

/// 残りの RAM を扱う（#408。#370 で決定。#73 で #408 の `kibi:memory` から `kibi:computer/memory` に移した）。
/// RAM は、初めて書き込んだ 4 KiB の区画の数で数える（#407）。加えて、線形メモリの区画の表を、宣言した・grow したページ数に比例して
/// 1 ページ 128 バイト（仮の値）数える（#753）。宣言しただけでも少し減る。
///
/// p1 向けには、ADR 0073 の規則でモジュール `kibi:computer/memory@0.1.0` の import（`remaining`・`commit`）として出している。
/// p2 向けには、`imports-p2` の world でそのまま出す（#777。ADR 0777）。`commit` の ptr は、canon lower した `commit` を import した
/// core インスタンスの 0 番の線形メモリの番地（wit-component が作る形では呼んだモジュールなので、p1 の「呼んだモジュールのメモリ」と
/// 同じ意味）。import した `commit` を export し直して別の core インスタンスが呼んでも、import した側のメモリで解く。
/// その core インスタンスがメモリを定義していない、または lower をそのまま lift した道など間に core インスタンスがないときは false。
interface memory {
    /// 残りの RAM（バイト）。プロセスの上限とマシンの RAM のうち、小さい方の残り。
    remaining: func() -> u64;

    /// [ptr, ptr+len) の区画を今のうちに数える。
    /// 数えた後の残りが keep 未満になるなら、何も数えずに false。
    /// 新しく数える区画がなければ true。範囲が線形メモリの外なら false。
    commit: func(ptr: u32, len: u32, keep: u64) -> bool;
}
