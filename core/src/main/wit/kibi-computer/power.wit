package kibi:computer@0.1.0;

/// コンピューターの電源（#306。ADR 0306）。止め方・再起動の順番は ADR 0049 のまま。
/// どのプロセスからでも呼べる（ADR 0046。マシンの中では権限を分けない）。p1・p2・p3 で同じ形（待たない）。
///
/// p1 向けには、ADR 0073 の規則でモジュール `kibi:computer/power@0.1.0` の import（`shutdown`・`reboot`）として出している。
interface power {
    use kibi:kernel/types@0.1.0.{error-code};

    /// マシンを止める。必ず受け付け、呼んだプロセスもその場で止まるので戻らない。
    shutdown: func();

    /// マシンを再起動する（すべてのプロセスを止めてから、最後の起動と同じ設定で起動し直す）。
    /// 受け付けたら、呼んだプロセスもその場で止まるので戻らない。
    /// 断ったときだけ戻り、`not-supported`: 起動も復元も通らずに作ったマシンと、サーバーを閉じる途中のとき。
    reboot: func() -> result<_, error-code>;
}
