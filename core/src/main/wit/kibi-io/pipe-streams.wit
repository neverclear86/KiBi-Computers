package kibi:io@0.1.0;

/// p2 のパイプ（ADR 0075）。仮置き: interface・関数・型・`wasi:*` の版は、p2 の層 #264 を作るときに直してよい（v0.1.0 までは版を変えずに直す）。
/// 2つの stream は同じカーネルのパイプ（ADR 0059）の両端を指す。
interface pipe-streams {
    use kibi:kernel/types@0.1.0.{error-code};
    use wasi:io/streams@0.2.3.{input-stream, output-stream};

    /// パイプを作り、読む端を input-stream、書く端を output-stream で返す。大きさは既定（仮の値 4096 バイト。確定は #251）。
    /// 書く端をすべて捨てると読む側は残りを読んだ後に stream-error.closed、読む端をすべて捨てると書く側は stream-error.closed。
    /// 待つのは各 stream の subscribe() の pollable で。マシン全体の上限なら nfile、ハンドル表が満杯なら mfile。
    create: func() -> result<tuple<input-stream, output-stream>, error-code>;
}
