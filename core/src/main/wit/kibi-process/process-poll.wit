package kibi:process@0.1.0;

/// p2 で、プロセスの終わりを待つ・p2 のハンドルを子に渡す（ADR 0074）。p1 では使わない。
/// #685 で確定（ADR 0685）。pollable はプロセスのハンドルの子で、子の pollable が残る process を捨てるとトラップ。
interface process-poll {
    use wasi:io/poll@0.2.12.{pollable};
    use wasi:io/streams@0.2.12.{input-stream, output-stream};
    use wasi:filesystem/types@0.2.12.{descriptor};
    use kibi:kernel/types@0.1.0.{error-code};
    use process.{process, spawn-options};

    /// 終わったら準備完了になる pollable。準備完了になっても刈り取らない（刈り取りは process.status）
    subscribe: func(p: borrow<process>) -> pollable;

    /// 子に渡す p2 のハンドル
    variant handle-source {
        input(borrow<input-stream>),
        output(borrow<output-stream>),
        directory(borrow<descriptor>),
        process(borrow<process>),
    }

    /// 子の fd 1つに当てるハンドル
    record handle-assign {
        fd: u32,
        source: handle-source,
    }

    /// process.spawn と同じ。options.fds の後に handles を当てる（同じ fd を両方に書いた・handles に同じ fd を2回書いたら invalid）。
    /// p2 の options.fds の parent(n) は n が 0・1・2 のときだけ（ほかは invalid。ほかのハンドルは handles で渡す）。
    /// input・output に渡せるのは、パイプの端・TTY・標準入出力の stream（get-stdin などで取ったもの）。
    /// 自分の位置で読み書きするファイルの stream（read-via-stream など）は not-supported、閉じた stream は bad-descriptor。
    /// directory は descriptor の flags（read・write）を子の fd の権利に写す。process は子に同じプロセスのハンドルを渡す
    spawn-with-handles: func(path: string, options: spawn-options, handles: list<handle-assign>) -> result<process, error-code>;
}
